APP_NAME=FlowForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8880
APP_PORT=8880
APP_HOST_PORT=8880
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — uses Docker service name as host
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5440
DB_DATABASE=flowforge
DB_USERNAME=flowforge
DB_PASSWORD=secret

# Redis — uses Docker service name as host
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379
REDIS_HOST_PORT=6381
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache, Sessions, Queues — all via Redis
CACHE_STORE=redis
CACHE_PREFIX=flowforge_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (Mailpit for local dev — http://localhost:8025)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@flowforge.test
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / Cloudflare R2 (file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Stripe (test mode only — never use live keys)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# AI Providers
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://ollama:11434

# Laravel Horizon
HORIZON_DOMAIN=
HORIZON_PATH=horizon

# Laravel Telescope (local dev only)
TELESCOPE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
